{
  "name": "party-crm-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run migrate && node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node server/db/seed.js",
    "setup": "node scripts/setup.js",
    "db:import": "node server/db/import-dump.js",
    "migrate": "node server/db/run-migrations.js",
    "migrate:status": "node server/db/run-migrations.js status",
    "import:leads": "node server/db/import-leads.js",
    "user:create": "node scripts/create-user.js",
    "db:backup": "node scripts/backup-db.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.20.0",
    "read-excel-file": "^9.3.12",
    "three": "^0.170.0",
    "write-excel-file": "^4.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
