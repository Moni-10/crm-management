# Copy to .env and adjust:  cp .env.example .env   (or run: npm run setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crm_app
DB_PASSWORD=
DB_NAME=party_crm
API_PORT=3001

# Set to production on the server. The app then refuses to start without JWT_SECRET.
NODE_ENV=development

# Login
# Long random string used to sign login tokens, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First admin account, created automatically only when there are no users yet.
# Change the password after the first login (profile menu > Settings).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Production
# Set to 1 when the app sits behind a reverse proxy (nginx, Caddy, IIS).
TRUST_PROXY=
# Only needed if the web app is served from a different address than the API (comma separated).
CORS_ORIGIN=

# Backups (npm run db:backup). Leave empty to auto-detect mysqldump.
MYSQLDUMP_PATH=
