# Copy to .env and adjust
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=party_crm
API_PORT=3001

# Login
# Long random string used to sign login tokens (generate your own).
JWT_SECRET=
# First admin account, created automatically when there are no users yet.
# Change the password after the first login (profile menu > Settings).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@mmw.local
ADMIN_PASSWORD=change-me-before-first-start

# Production
# Set to 1 when the app sits behind a reverse proxy (nginx, Caddy, IIS).
TRUST_PROXY=
